#!/usr/bin/env python3
"""Run one heavy command while holding a machine-wide work slot."""

import fcntl
import os
import subprocess
import sys
import time
from pathlib import Path

GIB = 1024**3


def linux_cores(cpu_root: Path = Path("/sys/devices/system/cpu")) -> int:
    cores = set()
    for cpu in cpu_root.glob("cpu[0-9]*"):
        topology = cpu / "topology"
        try:
            cores.add((
                (topology / "physical_package_id").read_text().strip(),
                (topology / "core_id").read_text().strip(),
            ))
        except FileNotFoundError:
            continue
    return len(cores) or os.cpu_count() or 1


def device_resources() -> tuple[int, int]:
    if sys.platform == "darwin":
        values = subprocess.check_output(
            ["sysctl", "-n", "hw.physicalcpu", "hw.memsize"], text=True
        ).split()
        return int(values[0]), int(values[1])
    if sys.platform.startswith("linux"):
        memory = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
        return linux_cores(), memory
    raise RuntimeError(f"unsupported platform: {sys.platform}")


def slot_capacity(cores: int, memory: int) -> int:
    cpu_budget = max(1, (cores - 2) // 2)
    memory_budget = max(1, (memory - max(4 * GIB, memory // 4)) // (4 * GIB))
    return min(cpu_budget, memory_budget)


def main() -> int:
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        print("usage: agent-slot -- command [args...] | agent-slot --status", file=sys.stderr)
        return 2

    cores, memory = device_resources()
    capacity = slot_capacity(cores, memory)
    if command == ["--status"]:
        print(f"agent-slot: {capacity} slots ({cores} cores, {memory / GIB:g} GiB RAM)")
        return 0

    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    lock_dir = state / "agent-slot"
    lock_dir.mkdir(parents=True, exist_ok=True)
    while True:
        for slot in range(1, capacity + 1):
            lock = (lock_dir / f"{slot}.lock").open("a")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                lock.close()
                continue
            print(f"agent-slot: acquired {slot}/{capacity}", file=sys.stderr, flush=True)
            try:
                return subprocess.run(command, check=False).returncode
            except KeyboardInterrupt:
                return 130
            finally:
                lock.close()
        time.sleep(0.5)


if __name__ == "__main__":
    raise SystemExit(main())
