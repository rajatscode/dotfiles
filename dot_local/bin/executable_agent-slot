#!/usr/bin/env python3
"""Run one command while holding one of two machine-wide work slots."""

import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time


def main() -> int:
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        print("usage: agent-slot -- command [args...]", file=sys.stderr)
        return 2

    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    lock_dir = state / "agent-slot"
    lock_dir.mkdir(parents=True, exist_ok=True)
    while True:
        for slot in range(1, 3):
            lock = (lock_dir / f"{slot}.lock").open("a")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                lock.close()
                continue
            print(f"agent-slot: acquired {slot}/2", file=sys.stderr, flush=True)
            try:
                return subprocess.run(command, check=False).returncode
            except KeyboardInterrupt:
                return 130
            finally:
                lock.close()
        time.sleep(0.5)


if __name__ == "__main__":
    raise SystemExit(main())
