#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6"]
# ///
"""Keep Claude Code auto-memory indexes trim.

For every <root>/*/memory/ directory holding a MEMORY.md:
  - ensure it is a local git repository (never adds remotes, never pushes);
  - move project memories untouched for --days into archive/ and index them
    in archive/INDEX.md (metadata.pinned: true keeps a file in place);
  - regenerate MEMORY.md from the frontmatter of the remaining files, keeping
    bullets that point at no memory file under an "Unfiled" section;
  - commit whatever changed.

  memory-groom                 groom every memory dir under ~/.claude/projects
  memory-groom --dry-run       print the diff, change nothing
  memory-groom --dir PATH      groom one memory dir (repeatable)

Environment: MEMORY_GROOM_ROOT, MEMORY_GROOM_DAYS (21), MEMORY_GROOM_BUDGET (6144).
"""

from __future__ import annotations

import argparse
import difflib
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

import yaml

INDEX = "MEMORY.md"
ARCHIVE = "archive"
ARCHIVE_INDEX = "INDEX.md"
DESCRIPTION_LIMIT = 100
TYPE_ORDER = ["user", "feedback", "project", "reference"]
TYPE_HEADINGS = {
    "user": "User",
    "feedback": "Feedback",
    "project": "Projects",
    "reference": "Reference",
}
UNFILED = "Unfiled"
NO_FRONTMATTER = "Missing frontmatter"
LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
BULLET = re.compile(r"^\s*[-*] ")


@dataclass
class Memory:
    file: str
    meta: dict | None
    title: str
    description: str

    def get(self, key: str):
        if not self.meta:
            return None
        nested = self.meta.get("metadata")
        if isinstance(nested, dict) and key in nested:
            return nested[key]
        return self.meta.get(key)

    @property
    def type(self) -> str:
        return str(self.get("type") or "").strip().lower()

    @property
    def section(self) -> str:
        if self.meta is None:
            return NO_FRONTMATTER
        custom = self.get("section")
        if custom:
            return str(custom).strip()
        return TYPE_HEADINGS.get(self.type, self.type.title() or "Other")


@dataclass
class Report:
    directory: Path
    before: int = 0
    after: int = 0
    archived: list[str] = field(default_factory=list)
    unfiled: list[str] = field(default_factory=list)
    missing_frontmatter: list[str] = field(default_factory=list)
    missing_type: list[str] = field(default_factory=list)
    missing_description: list[str] = field(default_factory=list)
    overlong_description: list[str] = field(default_factory=list)
    changed: bool = False
    diff: str = ""


def parse_frontmatter(text: str) -> dict | None:
    if not text.startswith("---"):
        return None
    lines = text.splitlines()
    for end in range(1, len(lines)):
        if lines[end].strip() == "---":
            try:
                data = yaml.safe_load("\n".join(lines[1:end]))
            except yaml.YAMLError:
                return None
            return data if isinstance(data, dict) else None
    return None


def shorten(text: str, limit: int = DESCRIPTION_LIMIT) -> str:
    text = " ".join(text.split())
    if len(text) <= limit:
        return text
    cut = text[: limit - 1]
    if " " in cut:
        cut = cut[: cut.rindex(" ")]
    return cut.rstrip(" ,;:—-") + "…"


def existing_titles(index_text: str) -> dict[str, str]:
    titles: dict[str, str] = {}
    for line in index_text.splitlines():
        if BULLET.match(line):
            match = LINK.search(line)
            if match:
                titles.setdefault(match.group(2), match.group(1))
    return titles


def load_memory(path: Path, rel: str, titles: dict[str, str]) -> Memory:
    meta = parse_frontmatter(path.read_text(encoding="utf-8", errors="replace"))
    memory = Memory(file=rel, meta=meta, title="", description="")
    title = memory.get("title") or titles.get(rel) or memory.get("name") or path.stem
    memory.title = " ".join(str(title).split())
    memory.description = " ".join(str(memory.get("description") or "").split())
    return memory


def git(directory: Path, *args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(directory), *args],
        capture_output=True,
        text=True,
        check=False,
    )
    if check and result.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed in {directory}: {result.stderr.strip()}")
    return result.stdout


def is_repo_root(directory: Path) -> bool:
    return (directory / ".git").exists()


def commit_times(directory: Path) -> dict[str, int]:
    """Latest commit time per path, from one pass over the log."""
    if not is_repo_root(directory) or not git(directory, "rev-parse", "--verify", "-q", "HEAD", check=False):
        return {}
    times: dict[str, int] = {}
    current = 0
    for line in git(directory, "log", "--format=@%ct", "--name-only", "--no-renames").splitlines():
        if line.startswith("@"):
            current = int(line[1:])
        elif line and line not in times:
            times[line] = current
    return times


def last_modified(directory: Path, rel: str, times: dict[str, int]) -> float:
    return max(times.get(rel, 0), (directory / rel).stat().st_mtime)


def render_line(memory: Memory, report: Report | None) -> str:
    if memory.meta is None:
        return f"- [{memory.title}]({memory.file})"
    if report is not None:
        if not memory.type:
            report.missing_type.append(memory.file)
        if not memory.description:
            report.missing_description.append(memory.file)
        elif len(memory.description) > DESCRIPTION_LIMIT:
            report.overlong_description.append(memory.file)
    if not memory.description:
        return f"- [{memory.title}]({memory.file})"
    return f"- [{memory.title}]({memory.file}) — {shorten(memory.description)}"


def section_key(name: str, members: list[Memory]) -> tuple:
    if name == NO_FRONTMATTER:
        return (len(TYPE_ORDER) + 2, 0, name)
    types = {m.type for m in members}
    rank = min((TYPE_ORDER.index(t) if t in TYPE_ORDER else len(TYPE_ORDER)) for t in types)
    is_default = any(TYPE_HEADINGS.get(m.type, m.type.title()) == name for m in members)
    return (rank, 0 if is_default else 1, name.lower())


def render_index(
    memories: list[Memory],
    order: dict[str, int],
    unfiled: list[str],
    has_archive: bool,
    report: Report | None,
) -> str:
    sections: dict[str, list[Memory]] = {}
    for memory in memories:
        sections.setdefault(memory.section, []).append(memory)
    out = ["# Memory Index", ""]
    for name, members in sorted(sections.items(), key=lambda item: section_key(*item)):
        members.sort(key=lambda m: (order.get(m.file, len(order)), m.file))
        out += [f"## {name}", *(render_line(m, report) for m in members), ""]
    if unfiled:
        out += [f"## {UNFILED}", *unfiled, ""]
    if has_archive:
        out += [f"Archived projects → [{ARCHIVE}/{ARCHIVE_INDEX}]({ARCHIVE}/{ARCHIVE_INDEX})", ""]
    return "\n".join(out).rstrip("\n") + "\n"


def render_archive_index(memories: list[Memory]) -> str:
    out = ["# Archived Memories", ""]
    for memory in sorted(memories, key=lambda m: m.file):
        line = render_line(memory, None)
        # Links are relative to archive/, so drop the directory prefix.
        out.append(line.replace(f"]({ARCHIVE}/", "](", 1))
    return "\n".join(out) + "\n"


def groom(directory: Path, days: float, dry_run: bool, now: float | None = None) -> Report:
    directory = directory.resolve()
    now = time.time() if now is None else now
    report = Report(directory=directory)
    index_path = directory / INDEX
    old_index = index_path.read_text(encoding="utf-8") if index_path.exists() else ""
    report.before = len(old_index.encode())
    titles = existing_titles(old_index)
    archive_dir = directory / ARCHIVE
    old_archive_path = archive_dir / ARCHIVE_INDEX
    old_archive = old_archive_path.read_text(encoding="utf-8") if old_archive_path.exists() else ""
    titles.update({f"{ARCHIVE}/{k}": v for k, v in existing_titles(old_archive).items()})

    if not dry_run:
        if not is_repo_root(directory):
            git(directory, "init", "-q")
        git(directory, "add", "-A")
    times = commit_times(directory)

    live: list[Memory] = []
    to_archive: list[Memory] = []
    for path in sorted(directory.glob("*.md")):
        if path.name == INDEX:
            continue
        memory = load_memory(path, path.name, titles)
        if memory.meta is None:
            report.missing_frontmatter.append(memory.file)
        stale = now - last_modified(directory, memory.file, times) > days * 86400
        if memory.type == "project" and memory.get("pinned") is not True and stale:
            to_archive.append(memory)
        else:
            live.append(memory)

    archived = [
        load_memory(path, f"{ARCHIVE}/{path.name}", titles)
        for path in sorted(archive_dir.glob("*.md"))
        if path.name != ARCHIVE_INDEX
    ]
    for memory in to_archive:
        report.archived.append(memory.file)
        moved = Memory(f"{ARCHIVE}/{memory.file}", memory.meta, memory.title, memory.description)
        archived = [m for m in archived if m.file != moved.file] + [moved]

    kept = {m.file for m in live if not m.get("in_claude_md")}
    known = {m.file for m in live} | {m.file for m in to_archive} | {m.file for m in archived}
    order: dict[str, int] = {}
    for line in old_index.splitlines():
        if not BULLET.match(line):
            continue
        match = LINK.search(line)
        target = match.group(2) if match else None
        if target in known:
            order.setdefault(target, len(order))
        elif not (target and target.startswith(f"{ARCHIVE}/")):
            report.unfiled.append(line.rstrip())

    new_index = render_index(
        [m for m in live if m.file in kept],
        order,
        report.unfiled,
        bool(archived),
        report,
    )
    new_archive = render_archive_index(archived) if archived else old_archive
    report.after = len(new_index.encode())

    diffs = []
    for name, old, new in ((INDEX, old_index, new_index), (f"{ARCHIVE}/{ARCHIVE_INDEX}", old_archive, new_archive)):
        if old != new:
            diffs.append("".join(difflib.unified_diff(
                old.splitlines(keepends=True), new.splitlines(keepends=True), f"a/{name}", f"b/{name}"
            )))
    for memory in to_archive:
        diffs.append(f"rename {memory.file} => {ARCHIVE}/{memory.file}\n")
    report.diff = "".join(diffs)
    report.changed = bool(diffs)

    if dry_run:
        return report

    if to_archive:
        archive_dir.mkdir(exist_ok=True)
        for memory in to_archive:
            git(directory, "mv", memory.file, f"{ARCHIVE}/{memory.file}")
    if new_index != old_index:
        index_path.write_text(new_index, encoding="utf-8")
    if new_archive != old_archive:
        old_archive_path.write_text(new_archive, encoding="utf-8")
    git(directory, "add", "-A")
    if git(directory, "status", "--porcelain"):
        report.changed = True
        git(directory, "commit", "-q", "-m", f"memory-groom: {summary(report)}")
    return report


def summary(report: Report) -> str:
    parts = []
    if report.archived:
        parts.append(f"archive {len(report.archived)}")
    parts.append(f"MEMORY.md {report.before}→{report.after} bytes")
    if report.unfiled:
        parts.append(f"{len(report.unfiled)} unfiled")
    return ", ".join(parts)


def print_report(report: Report, budget: int, dry_run: bool) -> None:
    print(f"== {report.directory}")
    print(f"MEMORY.md: {report.before} → {report.after} bytes")
    if report.after > budget:
        print(f"WARNING: MEMORY.md is {report.after} bytes, over the {budget}-byte budget")
    for label, items in (
        ("archived", report.archived),
        ("unfiled lines kept", report.unfiled),
        ("missing frontmatter", report.missing_frontmatter),
        ("missing metadata.type", report.missing_type),
        ("missing description", report.missing_description),
        (f"description over {DESCRIPTION_LIMIT} chars", report.overlong_description),
    ):
        if items:
            print(f"{label} ({len(items)}):")
            for item in items:
                print(f"  {item}")
    if dry_run and report.diff:
        print(report.diff, end="" if report.diff.endswith("\n") else "\n")
    if not report.changed:
        print("no changes")


def memory_dirs(root: Path) -> list[Path]:
    return sorted(p.parent for p in root.glob(f"*/memory/{INDEX}"))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="memory-groom", description=__doc__.split("\n\n")[0])
    parser.add_argument("--dry-run", action="store_true", help="print the diff and change nothing")
    parser.add_argument("--dir", action="append", type=Path, default=[], help="groom only this memory dir")
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(os.environ.get("MEMORY_GROOM_ROOT", Path.home() / ".claude" / "projects")),
    )
    parser.add_argument("--days", type=float, default=float(os.environ.get("MEMORY_GROOM_DAYS", 21)))
    parser.add_argument("--budget", type=int, default=int(os.environ.get("MEMORY_GROOM_BUDGET", 6144)))
    args = parser.parse_args(argv)

    dirs = args.dir or memory_dirs(args.root.expanduser())
    for directory in dirs:
        report = groom(directory.expanduser(), args.days, args.dry_run)
        print_report(report, args.budget, args.dry_run)
    return 0


if __name__ == "__main__":
    sys.exit(main())
