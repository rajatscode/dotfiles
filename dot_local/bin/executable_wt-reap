#!/usr/bin/env bash
# Report or remove finished git worktrees and the branches they left behind.
# Clean worktrees are candidates when their branch was merged, its PR was
# merged, or the worktree has passed the configured idle limit. Locked
# worktrees and worktrees with unpublished commits are kept.
#
#   wt-reap                 report candidates
#   wt-reap --apply         remove candidates
#   wt-reap --repo ~/src/x  inspect one repository
#
# Roots are listed one per line in ~/.config/wt-reap/roots. Each root may be
# a repository or a directory containing repositories. WT_REAP_ROOTS remains
# available as a space-separated override; --repo inspects explicit repos.

set -euo pipefail

apply=0
repos=()
roots_file="${WT_REAP_ROOTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/wt-reap/roots}"
idle_tmp_days="${WT_REAP_TMP_IDLE_DAYS:-3}"
idle_other_days="${WT_REAP_IDLE_DAYS:-14}"
cache_idle_days="${WT_REAP_CACHE_IDLE_DAYS:-3}"
log="${WT_REAP_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/wt-reap.log}"

while [ $# -gt 0 ]; do
    case "$1" in
        --apply) apply=1 ;;
        --repo)
            [ $# -ge 2 ] || { echo "wt-reap: --repo needs a path" >&2; exit 2; }
            repos+=("$2")
            shift
            ;;
        -h|--help)
            sed -n '2,10p' "$0"
            exit 0
            ;;
        *)
            echo "wt-reap: unknown argument $1" >&2
            exit 2
            ;;
    esac
    shift
done

mkdir -p "$(dirname "$log")"
say() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$log"
}

if [ ${#repos[@]} -eq 0 ]; then
    if [ -n "${WT_REAP_ROOTS:-}" ]; then
        read -r -a root_list <<< "$WT_REAP_ROOTS"
    elif [ -f "$roots_file" ]; then
        root_list=()
        while IFS= read -r root || [ -n "$root" ]; do
            root="${root%%#*}"
            root="${root#"${root%%[![:space:]]*}"}"
            root="${root%"${root##*[![:space:]]}"}"
            [ -n "$root" ] || continue
            case "$root" in
                '~/'*) root="$HOME/${root#\~/}" ;;
                '$HOME/'*) root="$HOME/${root#\$HOME/}" ;;
            esac
            root_list+=("$root")
        done < "$roots_file"
    elif [ -n "${WT_REAP_ROOTS_FILE:-}" ]; then
        say "roots file missing; no repositories scanned: $roots_file"
        root_list=()
    else
        root_list=()
    fi

    for root in "${root_list[@]}"; do
        if [ -d "$root/.git" ]; then
            repos+=("$root")
        else
            while IFS= read -r -d '' gitdir; do
                d="${gitdir%/.git}"
                [ -d "$gitdir" ] && repos+=("$d")
            done < <(find "$root" -maxdepth 4 \
                \( -name .git -prune -print0 \) -o \
                \( -type d \( -name node_modules -o -name .venv -o -name .cache -o -name vendor -o -name dist -o -name build -o -name target \) -prune \) 2>/dev/null)
        fi
    done
    [ "${#repos[@]}" -gt 0 ] || say "no repositories found in configured roots"
fi

reap_orphan_fsmonitors() {
    command -v pgrep >/dev/null 2>&1 || return 0
    local pid sock n=0
    for pid in $(pgrep -f 'git fsmonitor--daemon run' || true); do
        if command -v lsof >/dev/null 2>&1; then
            sock="$(lsof -p "$pid" -Fn 2>/dev/null | grep -m1 'fsmonitor--daemon\.ipc$' | sed 's/^n//')"
            case "$sock" in
                /*) [ -S "$sock" ] && continue ;;
            esac
        fi
        n=$((n + 1))
        if [ "$apply" = 1 ]; then
            kill "$pid" 2>/dev/null || true
        fi
    done
    [ "$n" = 0 ] || say "$([ "$apply" = 1 ] && echo reap || echo would) $n orphaned fsmonitor daemons"
}

pr_merged_from() {
    local repo="$1" branch="$2" slug
    command -v gh >/dev/null 2>&1 || return 1
    slug="$(git -C "$repo" remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
    [ -n "$slug" ] || return 1
    gh pr list -R "$slug" --head "$branch" --state merged --limit 1 --json number -q '.[0].number' 2>/dev/null
}

file_mtime() {
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo "$now"
}

dirty_mtime() {
    local wt="$1" last="$2" entry path mtime seen=0
    while IFS= read -r -d '' entry; do
        path="${entry:3}"
        if [ -e "$wt/$path" ] || [ -L "$wt/$path" ]; then
            mtime="$(file_mtime "$wt/$path")"
            [ "$mtime" -gt "$last" ] && last=$mtime
            seen=1
        fi
        case "${entry:0:2}" in
            *R*|*C*) IFS= read -r -d '' _ || true ;;
        esac
    done < <(git -C "$wt" status --porcelain=v1 -z --untracked-files=all)
    if [ "$seen" = 0 ]; then
        mtime="$(file_mtime "$wt/.git")"
        [ "$mtime" -gt "$last" ] && last=$mtime
    fi
    echo "$last"
}

trim_idle_cache() {
    local wt="$1" last idle_days gitdir path rel head_commit wt_real path_real
    local -a candidates=()

    gitdir="$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
    [ ! -e "$gitdir/locked" ] || return 0
    last="$(file_mtime "$wt/.git")"
    head_commit="$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo "$now")"
    [ "$head_commit" -gt "$last" ] && last="$head_commit"
    idle_days=$(( (now - last) / 86400 ))
    [ "$idle_days" -ge "$cache_idle_days" ] || return 0
    wt_real="$(cd "$wt" && pwd -P)"

    for path in "$wt/node_modules" "$wt/.venv" "$wt"/*/.venv; do
        [ -d "$path" ] && [ ! -L "$path" ] || continue
        path_real="$(cd "$path" && pwd -P)"
        case "$path_real" in "$wt_real"/*) ;; *) continue ;; esac
        rel="${path#"$wt"/}"
        git -C "$wt" check-ignore -q -- "$rel" || continue
        candidates+=("$path")
    done
    [ "${#candidates[@]}" -gt 0 ] || return 0

    if worktree_in_use "$wt"; then
        say "keep  cache $wt (process working in worktree)"
        return 0
    fi

    for path in "${candidates[@]}"; do
        [ "$apply" = 1 ] && rm -rf -- "$path"
        say "$([ "$apply" = 1 ] && echo trim || echo would) cache $path (worktree idle ${idle_days}d)"
    done
}

worktree_in_use() {
    local wt="$1" active_cwds
    command -v lsof >/dev/null 2>&1 || return 0
    active_cwds="$(lsof -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" || return 0
    wt="$(cd "$wt" && pwd -P)"
    printf '%s\n' "$active_cwds" | awk -v wt="$wt" '$0 == wt || index($0, wt "/") == 1 { found=1 } END { exit !found }'
}

# launchd does not set TMPDIR. On macOS, use the per-user temporary directory
# so its shorter idle limit also applies when the scheduled job runs.
tmp_dir="${TMPDIR:-$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || echo /tmp)}"
tmp_prefix="$(cd "$tmp_dir" 2>/dev/null && pwd -P)"
now=$(date +%s)
removed=0
kept=0

for repo in "${repos[@]}"; do
    main_dir="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || continue
    default_branch="$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    default_branch="${default_branch#origin/}"
    default_branch="${default_branch:-main}"

    git -C "$repo" worktree prune
    git -C "$repo" fetch --quiet --prune origin 2>/dev/null || true

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        wt="${line#worktree }"
        [ "$wt" = "$main_dir" ] && continue
        [ -d "$wt" ] || continue

        branch="$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || true)"
        dirty="$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d ' ')"

        unpushed=0
        reason=""
        if [ -n "$branch" ]; then
            if git -C "$wt" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
                unpushed="$(git -C "$wt" rev-list --count "origin/$branch..HEAD")"
                if git -C "$repo" merge-base --is-ancestor "$branch" "origin/$default_branch" 2>/dev/null; then
                    reason="merged into $default_branch"
                fi
            elif git -C "$repo" merge-base --is-ancestor "$branch" "origin/$default_branch" 2>/dev/null; then
                reason="branch gone, content in $default_branch"
            elif merged_pr="$(pr_merged_from "$repo" "$branch")" && [ -n "$merged_pr" ]; then
                reason="PR #$merged_pr merged"
            else
                if git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$default_branch" >/dev/null; then
                    unpushed="$(git -C "$wt" rev-list --count "origin/$default_branch..HEAD")"
                else
                    # A repo without a fetched default branch cannot prove this
                    # worktree is published. Keep it instead of aborting the run.
                    unpushed="$(git -C "$wt" rev-list --count HEAD)"
                fi
            fi
        fi

        if [ "$unpushed" != 0 ]; then
            [ "$dirty" != 0 ] || trim_idle_cache "$wt"
            say "keep  $wt ($unpushed unpushed commits on ${branch:-detached})"
            kept=$((kept + 1))
            continue
        fi

        if [ "$dirty" != 0 ]; then
            head_commit="$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo "$now")"
            last="$(dirty_mtime "$wt" "$head_commit")"
        elif [ -z "$reason" ]; then
            last="$(file_mtime "$wt/.git")"
            head_commit="$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo "$now")"
            [ "$head_commit" -gt "$last" ] && last=$head_commit
        fi

        if [ "$dirty" != 0 ] || [ -z "$reason" ]; then
            idle_days=$(( (now - last) / 86400 ))
            case "$(cd "$wt" && pwd -P)" in
                "$tmp_prefix"/*) limit=$idle_tmp_days ;;
                *) limit=$idle_other_days ;;
            esac
            if [ "$idle_days" -lt "$limit" ]; then
                if [ "$dirty" != 0 ]; then
                    say "keep  $wt (dirty: $dirty paths, idle ${idle_days}d < ${limit}d)"
                else
                    say "keep  $wt (idle ${idle_days}d < ${limit}d, ${branch:-detached})"
                fi
                kept=$((kept + 1))
                continue
            fi
            if [ "$dirty" != 0 ]; then
                reason="dirty: $dirty paths, idle ${idle_days}d"
            else
                reason="idle ${idle_days}d"
            fi
        fi

        if worktree_in_use "$wt"; then
            say "keep  $wt (process working in worktree)"
            kept=$((kept + 1))
            continue
        fi

        if [ "$apply" = 1 ]; then
            git -C "$wt" fsmonitor--daemon stop >/dev/null 2>&1 || true
            if ! git -C "$repo" worktree remove --force "$wt" 2>/dev/null; then
                say "keep  $wt (locked or in use)"
                kept=$((kept + 1))
                continue
            fi
            if [ -n "$branch" ] && [ "$branch" != "$default_branch" ]; then
                git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
            fi
            say "reap  $wt ($reason, ${branch:-detached})"
        else
            say "would $wt ($reason, ${branch:-detached})"
        fi
        removed=$((removed + 1))
    done < <(git -C "$repo" worktree list --porcelain | grep '^worktree ')

    while IFS= read -r branch; do
        [ -n "$branch" ] || continue
        reason=""
        if git -C "$repo" merge-base --is-ancestor "$branch" "origin/$default_branch" 2>/dev/null; then
            reason="gone, merged"
        elif merged_pr="$(pr_merged_from "$repo" "$branch")" && [ -n "$merged_pr" ]; then
            reason="gone, PR #$merged_pr merged"
        fi
        [ -n "$reason" ] || continue
        git -C "$repo" worktree list --porcelain | grep -q "^branch refs/heads/$branch$" && continue
        if [ "$apply" = 1 ]; then
            git -C "$repo" branch -D "$branch" >/dev/null 2>&1 && say "reap  branch $repo:$branch ($reason)"
        else
            say "would branch $repo:$branch ($reason)"
        fi
    done < <(git -C "$repo" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2=="[gone]"{print $1}')
done

reap_orphan_fsmonitors
say "done: $removed to reap, $kept kept$([ "$apply" = 1 ] || echo ' (dry run; --apply to act)')"
