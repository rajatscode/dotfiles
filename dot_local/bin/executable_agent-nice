#!/usr/bin/env bash
# Lower the CPU priority of coding-agent CLIs and everything they spawn, so the
# desktop stays responsive when agents run builds and tests in parallel.
#
#   agent-nice            report processes that would be reniced
#   agent-nice --apply    renice them
#
# An agent is a process whose command is one of $AGENT_NICE_COMMANDS (default:
# claude codex), run directly or through node. Every descendant is included,
# whichever shell, terminal, or IDE started the agent. Processes already at
# $AGENT_NICE_LEVEL (10) or lower priority are left alone; niceness is only raised.
set -euo pipefail

apply=0
level="${AGENT_NICE_LEVEL:-10}"
commands="${AGENT_NICE_COMMANDS:-claude codex}"

case "${1:-}" in
    --apply) apply=1 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    "") ;;
    *) echo "agent-nice: unknown argument $1" >&2; exit 2 ;;
esac

pids="$(ps -Ao pid=,ppid=,ni=,args= | awk -v level="$level" -v commands="$commands" '
    function base(p) { sub(/.*\//, "", p); return p }
    BEGIN { n = split(commands, c, " "); for (i = 1; i <= n; i++) agent[c[i]] = 1 }
    {
        pid = $1; ppid[pid] = $2; ni[pid] = $3
        cmd = base($4)
        if (cmd in agent || (cmd == "node" && base($5) in agent)) root[pid] = 1
    }
    END {
        for (pid in ppid) {
            p = pid
            while (p != "" && p > 1) {
                if (p in root) { if (ni[pid] < level) print pid; break }
                p = ppid[p]
            }
        }
    }')"

[ -n "$pids" ] || exit 0
if [ "$apply" = 1 ]; then
    # A process can exit between ps and renice; that is not an error.
    renice -n "$level" -p $pids >/dev/null 2>&1 || true
else
    echo "would renice to $level: $(echo $pids | wc -w | tr -d ' ') processes"
fi
